# Copy to .env and edit. Every setting is optional.

# live = real public feeds (adsb.lol, Celestrak, Open-Meteo, USGS). Needs internet.
# demo = generated 8-day world with scripted scenarios. Works offline.
DATA_MODE=live

# Regenerate the demo world on next start (demo mode only)
DEMO_RESET=0

# Live ingestion loop
LIVE_INGEST=1
LIVE_INGEST_INTERVAL_S=600
RETENTION_DAYS=3

# Optional: AI-written report assessments. Without a key a template writes them.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Disruption index bands: Calm < LOW <= Watch < MEDIUM <= Elevated < HIGH <= Critical
SEVERITY_LOW=20
SEVERITY_MEDIUM=40
SEVERITY_HIGH=70

# Flight route deviation threshold (km)
FLIGHT_DEVIATION_LIMIT_KM=300

# Host ports
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432
