# Copy to .env and edit. Provision DEMO_PASSWORD_HASH for password-based login.

# live = real public feeds (adsb.lol, Celestrak, Open-Meteo, USGS). Needs internet.
# demo = generated 8-day world with scripted scenarios. Works offline.
DATA_MODE=live

# Regenerate the demo world on next start (demo mode only)
DEMO_RESET=0

# Disable external acquisition with LIVE_INGEST=0. Providers use separate cadences.
LIVE_INGEST=1
# Legacy manual-ingestion setting; supervised collectors use the source catalogue.
LIVE_INGEST_INTERVAL_S=600
# Legacy flight/weather retention; normalized observations archive after seven days.
RETENTION_DAYS=3

# Optional: AI-written report assessments. Without a key a template writes them.
ANTHROPIC_API_KEY=
# Set an exact model ID available to your Anthropic account if enabling AI.
ANTHROPIC_MODEL=

# Disruption index bands: Calm < LOW <= Watch < MEDIUM <= Elevated < HIGH <= Critical
SEVERITY_LOW=20
SEVERITY_MEDIUM=40
SEVERITY_HIGH=70

# Flight route deviation threshold (km)
FLIGHT_DEVIATION_LIMIT_KM=300

# Host ports
WEB_PORT=5173
API_PORT=8000
DB_PORT=5432

# Demo authentication: generate a hash with `python -m app.provision_demo`.
DEMO_EMAIL=demo@skynexus.local
DEMO_PASSWORD_HASH=
# Password-free public demo sessions; set false for a restricted deployment.
DEMO_DIRECT_LOGIN=true
COOKIE_SECURE=0
REDIS_URL=redis://redis:6379/0
# Free source credentials; keep all values on the server.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
EIA_API_KEY=
CLOUDFLARE_API_TOKEN=
GFW_API_TOKEN=
EWDS_API_TOKEN=

# Local archives work without a cloud account.
ARCHIVE_STORAGE=local
ARTIFACT_DIR=artifacts
# Optional MBTA key increases allowance; public keyless matching works.
MBTA_API_KEY=
# Optional private S3-compatible/R2 archive storage; use ARCHIVE_STORAGE=r2.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PUBLIC_ORIGIN=http://localhost:5173
